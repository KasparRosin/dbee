<?xml version="1.0" encoding="UTF-8"?>
<!-- shared-mime-info for the formats dbee opens. Current distros already ship a definition for
     the SQLite type; this entry only makes sure the globs are known on minimal systems. The
     system's own definitions win where they exist. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.sqlite3">
    <comment>SQLite database</comment>
    <glob pattern="*.sqlite"/>
    <glob pattern="*.sqlite3"/>
    <magic priority="60"><match type="string" offset="0" value="SQLite format 3"/></magic>
  </mime-type>
  <mime-type type="application/x-sqlite3">
    <sub-class-of type="application/vnd.sqlite3"/>
    <comment>SQLite database</comment>
  </mime-type>
</mime-info>
