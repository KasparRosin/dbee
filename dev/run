#!/usr/bin/env bash
# Builds dbee's development image when it changed, and starts it: a shell, or the command given.
#   dev/run                  a shell in the container
#   dev/run cargo xtask ci   one command
# See dev/README.md.
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
image=dbee-dev
state=${DBEE_DEV_STATE:-$HOME/.local/share/dbee-dev}
socket=/var/run/docker.sock

fail() { echo "dev/run: $*" >&2; exit 1; }

rust=$(sed -n 's/^channel *= *"\(.*\)"/\1/p' "$root/rust-toolchain.toml")
[ -n "$rust" ] || fail "no channel in rust-toolchain.toml"

# The container is handed the host's own Docker socket, so the host's commands here must use the
# same daemon, and that daemon must run as root (rootless Docker gives files in the repo another owner).
[ -z "${DOCKER_HOST:-}" ] || fail "DOCKER_HOST is set; dev/run needs the local Docker Engine at $socket"
[ "$(docker context show)" = default ] || fail "the Docker context is not 'default'; dev/run needs the local Docker Engine at $socket"
[ -S "$socket" ] || fail "no Docker socket at $socket; dev/run needs Docker Engine running as root"
case $(docker info --format '{{.SecurityOptions}}') in
    *rootless*) fail "Docker runs rootless; dev/run needs Docker Engine running as root" ;;
esac

# A build folder outside the repository would be lost when the container ends.
if [ -n "${CARGO_TARGET_DIR:-}" ]; then
    CARGO_TARGET_DIR=$(realpath -m "$CARGO_TARGET_DIR")
    case $CARGO_TARGET_DIR/ in "$root"/*) ;; *) fail "CARGO_TARGET_DIR must be inside $root" ;; esac
fi

docker image inspect "$image" >/dev/null 2>&1 || echo "dev/run: building the $image image (a few minutes the first time)..." >&2
docker build --quiet --tag "$image" \
    --build-arg RUST_VERSION="$rust" \
    --build-arg USER_NAME="$(id -un)" \
    --build-arg USER_UID="$(id -u)" \
    --build-arg USER_GID="$(id -g)" \
    --build-arg HOME_DIR="$HOME" \
    "$root/dev" >/dev/null
# The image a rebuild replaced.
docker image prune --force --filter label=dev.dbee.image=dev >/dev/null

# Made here, so Docker doesn't make them as root.
mkdir -p "$state/claude" "$state/local" "$state/cargo"

case $(pwd -P)/ in "$root"/*) workdir=$(pwd -P) ;; *) workdir=$root ;; esac

args=(
    --rm --init --network host
    --group-add "$(stat -c %g "$socket")"
    --volume "$socket:$socket"
    # The repository at its own path, so paths xtask hands the host's Docker resolve there too.
    --volume "$root:$root"
    --workdir "$workdir"
    # Claude Code's sign-in and settings, and its install.
    --volume "$state/claude:$HOME/.claude"
    --volume "$state/local:$HOME/.local"
    # Cargo's home: its downloads and their lock, shared by every container.
    --volume "$state/cargo:$HOME/.cargo"
    --volume /etc/localtime:/etc/localtime:ro
    --env "TERM=${TERM:-xterm-256color}"
)
[ -t 0 ] && [ -t 1 ] && args+=(--interactive --tty)
for v in COLORTERM CARGO_TARGET_DIR CARGO_BUILD_JOBS; do
    [ -n "${!v:-}" ] && args+=(--env "$v=${!v}")
done

# A worktree's git data lives in the clone it was made from.
common=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
case ${common:-$root}/ in "$root"/*) ;; *) args+=(--volume "$common:$common") ;; esac

# Git settings, read-only, with the files they include.
gitfiles=("$HOME/.gitconfig" "$HOME/.config/git")
while IFS= read -r f; do
    case $f in \~/*) f=$HOME/${f#\~/} ;; /*) ;; *) f=$HOME/$f ;; esac
    gitfiles+=("$f")
done < <(git config --global --get-all include.path 2>/dev/null || true)
for f in "${gitfiles[@]}"; do
    [ -e "$f" ] && args+=(--volume "$f:$f:ro")
done

# SSH: an agent that holds keys, with only the known hosts; else the key files.
if [ -S "${SSH_AUTH_SOCK:-}" ] && ssh-add -l >/dev/null 2>&1; then
    args+=(--volume "$SSH_AUTH_SOCK:/run/ssh-agent.sock" --env SSH_AUTH_SOCK=/run/ssh-agent.sock)
    [ -f "$HOME/.ssh/known_hosts" ] && args+=(--volume "$HOME/.ssh/known_hosts:$HOME/.ssh/known_hosts:ro")
elif [ -d "$HOME/.ssh" ]; then
    args+=(--volume "$HOME/.ssh:$HOME/.ssh:ro")
fi

exec docker run "${args[@]}" "$image" "$@"
